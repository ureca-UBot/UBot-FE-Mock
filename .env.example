# 각 개발자는 이 파일을 복사해 .env.local 로 사용하세요.
# .env.local 은 .gitignore의 *.local 규칙으로 Git에 올라가지 않습니다.

# 프론트 코드에서 사용할 API prefix입니다.
# 로컬 개발에서는 Vite가 /api 요청을 아래 Spring 서버로 프록시합니다.
VITE_API_BASE_URL=/api

# 각자 실행 중인 Spring Boot 서버 주소로 변경하세요.
VITE_API_PROXY_TARGET=http://localhost:8080

# Kakao Developers > 앱 > 앱 키의 JavaScript 키를 넣으세요.
# 브라우저 지도 렌더링용 키이며 KAKAO_REST_API_KEY와는 다른 키입니다.
VITE_KAKAO_JAVASCRIPT_KEY=
